# ---------------------------------------------------------------------------
# Wallets: use EITHER a mnemonic OR individual private keys, never both.
# ---------------------------------------------------------------------------

# Option A (recommended): one BIP-39 phrase, wallets derived from it.
# Derivation is m/44'/60'/0'/0/i - index i is the address your wallet app
# shows as account i+1, so you can fund them straight from MetaMask/Rabby.
MNEMONIC="word1 word2 word3 ... word12"
WALLET_COUNT=5
# Start at a different account index if account 0 is already in use.
WALLET_START_INDEX=0
# BIP-39 25th-word passphrase. Leave unset unless you know you use one -
# setting it derives a COMPLETELY different, unfunded set of wallets.
# MNEMONIC_PASSPHRASE=
# Only change if your wallet app uses a non-standard path.
# DERIVATION_PATH=m/44'/60'/0'/0

# Option B: explicit private keys, generated offline by the operator.
# PK_0=0x...
# PK_1=0x...
# PK_2=0x...
# PK_3=0x...
# PK_4=0x...

# ---------------------------------------------------------------------------
# Optional overrides - defaults are the verified values
# ---------------------------------------------------------------------------
RPC_URL=https://rpc.mainnet.chain.robinhood.com
SEQUENCER_URL=https://sequencer.mainnet.chain.robinhood.com
RECIPIENT=0x31F7E03c18A86a947e3E689C9B1B040fECBa38Ec
POLL_INTERVAL_MS=50
QUANTITY=2

# Safety latch. The bot refuses to broadcast unless this is exactly "true".
ARMED=false
